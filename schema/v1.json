{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "illust-sidecar v1",
  "description": "Metadata for an illustration, saved next to the image as '<image file name>.json' (foo.png -> foo.png.json). Omit empty fields; keep unknown keys.",
  "type": "object",
  "required": ["v"],
  "properties": {
    "$schema": { "type": "string" },
    "v": {
      "const": 1,
      "description": "Spec version."
    },
    "title": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "'namespace:value' allowed (character:, series:, set:, creator:, rating:, age:)."
    },
    "urls": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "uniqueItems": true,
      "description": "Source URLs; the first is primary."
    },
    "note": { "type": "string" },
    "added": {
      "type": "string",
      "format": "date-time",
      "description": "When added to your collection (ISO 8601)."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Of the image file; for relinking."
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "v": 1
    },
    {
      "v": 1,
      "title": "夕暮れの駅前",
      "tags": [
        "風景",
        "夕焼け",
        "series:架空の街",
        "character:駅員さん",
        "creator:サンプル太郎",
        "rating:4",
        "age:general"
      ],
      "urls": ["https://example.com/artworks/12345678"],
      "note": "壁紙候補",
      "added": "2026-11-03T14:11:00+09:00"
    },
    {
      "v": 1,
      "title": "Rainy Window",
      "tags": [
        "rain",
        "window",
        "series:Original",
        "character:Girl with umbrella",
        "creator:Jane Doe",
        "rating:5",
        "age:general"
      ],
      "urls": ["https://example.com/posts/1234567890"],
      "note": "Good reference for reflections.",
      "added": "2026-10-20T21:30:00+09:00"
    }
  ]
}
